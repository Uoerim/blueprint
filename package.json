{
  "name": "blueprint",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "dotenv -e .env.local -e .env -- prisma db push",
    "db:migrate": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -e .env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -e .env -- prisma studio",
    "team:role": "dotenv -e .env.local -e .env -- tsx prisma/set-role.ts",
    "site:role": "dotenv -e .env.local -e .env -- tsx prisma/site-role.ts",
    "db:encrypt": "dotenv -e .env.local -e .env -- tsx prisma/encrypt-existing.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:deploy": "dotenv -e .env.local -e .env -- prisma migrate deploy"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.15",
    "@dnd-kit/core": "^6.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^14.2.0",
    "lru-cache": "^11.5.3",
    "next": "16.4.1",
    "prisma": "^6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
