# ── Clerk ─────────────────────────────────────────────────────────────────────
# `npx -y clerk@latest init` (or `clerk env pull`) writes these into .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ── Neon Serverless Postgres ──────────────────────────────────────────────────
# Pooled (pgbouncer) URL — used by the app at runtime via the Neon driver adapter
POSTGRES_PRISMA_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# Direct URL — used by `prisma db push` / `prisma migrate`
POSTGRES_URL_NON_POOLING=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Optional: shared rate-limit store (recommended in production) ────────────
# Without these the limiter uses an in-memory sliding window per server instance.
# Vercel Marketplace "Upstash for Redis" injects the KV_* pair automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# or, from the Upstash console directly:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional: invite your own @username to the demo teams when seeding ────────
# SEED_INVITE_USERNAME=your_username

# ── Required in production: field encryption key ──────────────────────────────
# Idea and task text is encrypted with AES-256-GCM using per-team keys derived
# from this secret. 32 bytes as 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and back it up: if it is lost or changed, encrypted text can
# no longer be read. Optional in local development (text is stored plain).
ENCRYPTION_KEY=
