// Neon Serverless Postgres via Prisma.
// POSTGRES_PRISMA_URL      -> pooled connection (pgbouncer) used by the app at runtime
// POSTGRES_URL_NON_POOLING -> direct connection used by migrations / db push

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// engineType "client" = Rust-free Prisma Client running on the Neon serverless
// driver adapter (lib/db.ts). No native query engine, so it also runs on
// Windows ARM64, edge-style runtimes and anywhere Node runs.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

model User {
  id                 String            @id @default(cuid())
  clerkId            String            @unique
  email              String            @unique
  username           String?           @unique
  displayName        String?
  /// Clerk profile picture, only when the person uploaded one (otherwise initials are shown).
  imageUrl           String?
  /// Bumped whenever something lands in this person's notifications (invites).
  inboxAt            DateTime          @default(now())
  accentColor        String            @default("#6366F1")
  onboarded          Boolean           @default(false)
  /// Guided tours this person has finished or skipped ("welcome", "team"). See components/tour.
  toursDone          String[]          @default([])
  /// Site-wide staff role (separate from per-team roles). See lib/site-roles.ts.
  siteRole           SiteRole          @default(USER)
  /// Set when staff suspend the account; blocks every page, action and API call.
  bannedAt           DateTime?
  banReason          String?
  /// Set when an admin deletes the account: personal fields are scrubbed and the row is kept as a tombstone.
  deletedAt          DateTime?
  /// The @username an account had when staff deleted it, kept for the security record.
  deletedUsername    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  teamsOwned         Team[]            @relation("TeamOwner")
  memberships        TeamMember[]
  invitesSent        TeamInvite[]      @relation("Inviter")
  invitesRecv        TeamInvite[]      @relation("Invitee")
  ideasCreated       Idea[]
  tasksCreated       Task[]
  tasksDone          Task[]            @relation("TaskCompletedBy")
  taskAssignments    TaskAssignee[]
  subtaskAssignments SubtaskAssignee[]
  bugReports         BugReport[]       @relation("BugReports")

  @@index([siteRole])
}

enum SiteRole {
  USER
  SUPPORT
  MODERATOR
  ADMIN
}

model Team {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  createdById String
  createdBy   User         @relation("TeamOwner", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  invites     TeamInvite[]
  ideas       Idea[]
  tasks       Task[]
  roles       TeamRole[]
  tags        TeamTag[]
  /// Bumped on every change inside the team; the live change-check compares it.
  activityAt  DateTime     @default(now())
}

model TeamMember {
  id           String    @id @default(cuid())
  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @default(MEMBER)
  /// Optional custom role (members only). Owners and co-owners have fixed permissions.
  customRoleId String?
  customRole   TeamRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  /// Starred by this member: shown first on the dashboard home and in the team switcher.
  favorite     Boolean   @default(false)
  joinedAt     DateTime  @default(now())

  @@unique([teamId, userId])
  @@index([userId])
  @@index([customRoleId])
}

/// A custom team role made by the owner or a co-owner: a name, a colour and a
/// set of permissions from lib/team-permissions.ts.
/// A team's idea tags. Ideas store tag names; renaming or deleting a tag updates them.
model TeamTag {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime @default(now())

  @@unique([teamId, name])
  @@index([teamId])
}

model TeamRole {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  color       String       @default("#8B5CF6")
  permissions String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]

  @@unique([teamId, name])
  @@index([teamId])
}

enum Role {
  OWNER
  CO_OWNER
  MEMBER
}

model TeamInvite {
  id          String       @id @default(cuid())
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User         @relation("Inviter", fields: [inviterId], references: [id])
  inviteeId   String
  invitee     User         @relation("Invitee", fields: [inviteeId], references: [id])
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@unique([teamId, inviteeId, status])
  @@index([inviteeId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Idea {
  id               String     @id @default(cuid())
  teamId           String
  team             Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  /// Legacy project notes (no longer shown; kept so nothing written there is lost).
  notes            String?
  tags             String[]
  status           IdeaStatus @default(VAULT)
  sparksCount      Int        @default(0)
  sparkedByUserIds String[]
  createdById      String
  createdBy        User       @relation(fields: [createdById], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  tasks            Task[]

  @@index([teamId])
}

enum IdeaStatus {
  VAULT
  PROMOTED
  ARCHIVED
}

model Task {
  id            String         @id @default(cuid())
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ideaId        String?
  idea          Idea?          @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  /// Encrypted (enc:v1:…), like description, notes and subtask titles.
  title         String
  description   String?
  /// Team tag names (plain, like idea tags), so the board can filter and sort.
  tags          String[]       @default([])
  notes         String?
  status        TaskStatus     @default(TODO)
  priority      Priority       @default(MEDIUM)
  /// TEAM: everyone on the team. ASSIGNEES: assignees, the creator, the owner and co-owners only.
  visibility    TaskVisibility @default(TEAM)
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id])
  completedById String?
  completedBy   User?          @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignees     TaskAssignee[]
  subtasks      Subtask[]

  @@index([teamId])
  @@index([teamId, status])
}

/// Who a task is assigned to. `focusedAt` is set while that person is
/// actively working on it (Live focus), so focus is per person, not per task.
model TaskAssignee {
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId     String
  focusedAt  DateTime?
  assignedAt DateTime  @default(now())

  @@id([taskId, userId])
  @@index([userId, teamId])
}

model Subtask {
  id          String            @id @default(cuid())
  teamId      String
  taskId      String
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  description String?
  done        Boolean           @default(false)
  position    Int               @default(0)
  createdById String
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assignees   SubtaskAssignee[]

  @@index([taskId])
}

model SubtaskAssignee {
  subtaskId String
  subtask   Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([subtaskId, userId])
  @@index([userId])
}

enum TaskVisibility {
  TEAM
  ASSIGNEES
}

// TODO is shown as "Backlog" on the board; READY was added so the board can
// carry four columns (Backlog -> Ready -> In Progress -> Done).
enum TaskStatus {
  TODO
  READY
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// Append-only security trail: metadata only, never idea or task content.
/// Updates and deletes are refused by the Prisma client (lib/prisma.ts) and by
/// a database trigger (migration 6_audit_append_only).
model AuditLog {
  id            String   @id @default(cuid())
  teamId        String?
  userId        String
  /// The actor's @username when the event happened, kept after renames and deletions.
  actorUsername String?
  action        String
  entityType    String
  entityId      String
  /// Shortened to the network (IPv4 /24, IPv6 /48), never the full address.
  ipAddress     String
  createdAt     DateTime @default(now())

  @@index([teamId, createdAt])
}

/// A bug report sent from the Contact support window, read by staff in the
/// admin panel. The text is encrypted at rest with its own key, separate from
/// every team's (lib/bug-reports.ts).
model BugReport {
  id           String          @id @default(cuid())
  userId       String?
  user         User?           @relation("BugReports", fields: [userId], references: [id], onDelete: SetNull)
  /// The reporter's @username when they sent it, kept after a rename or deletion.
  username     String?
  /// A bug report or a feature request.
  kind         FeedbackKind    @default(BUG)
  /// Encrypted (enc:v1:…). Up to 2,000 characters before encryption.
  body         String
  /// The page they were on, path only (no query string), e.g. /dashboard/night-shift.
  page         String?
  /// A short device summary like "iPhone · Safari · installed app", never the full user agent.
  device       String?
  status       BugReportStatus @default(OPEN)
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([status, createdAt])
}

enum FeedbackKind {
  BUG
  FEATURE
}

enum BugReportStatus {
  OPEN
  RESOLVED
}
